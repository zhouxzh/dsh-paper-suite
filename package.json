{
  "name": "dsh-paper-suite",
  "version": "0.4.0",
  "private": true,
  "description": "Paper suite for DeepSeek Harness: Chinese/English LaTeX paper scaffolding, evidence-chain audit, build diagnostics, remote evidence sync, reviewer response letters and cover letters.",
  "author": "Xianzhong Zhou <zhouxzh@gdut.edu.cn>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./audit": {
      "default": "./lib/audit.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "SOURCE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "pretest": "node scripts/link-stub.mjs",
    "test": "node --check lib/client.js && node test/smoke.mjs && node test/scholarship.mjs && node test/host.mjs && node test/client.mjs && node test/skills.mjs",
    "skills:install": "node scripts/install-skill.mjs",
    "skills:check": "node scripts/install-skill.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouxzh/dsh-paper-suite.git"
  },
  "homepage": "https://github.com/zhouxzh/dsh-paper-suite#readme",
  "bugs": {
    "url": "https://github.com/zhouxzh/dsh-paper-suite/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "latex",
    "academic-writing",
    "citation",
    "research-tools"
  ],
  "license": "MIT"
}
